# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create a Desktop-app OAuth client at https://console.cloud.google.com/apis/credentials
# with the Gmail API enabled, then paste the values here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Loopback only. Do not expose this API to your network.
HOST=127.0.0.1
# Every origin that may call this API. Add your GitHub Pages URL here.
ALLOWED_ORIGINS=http://localhost:5173,https://illydh.github.io
# Set this to require a password before the UI shows any mailbox data.
# Leave blank to keep the app open to anyone with access to this machine or browser.
APP_PASSWORD=

# ── Sync window ──────────────────────────────────────────────────────────────
# Earliest email to consider (YYYY-MM-DD).
SYNC_SINCE=2026-08-01
MAX_MESSAGES_PER_SYNC=400
# Auto-sync cadence in minutes once the server is running unattended. 0 disables it.
SYNC_INTERVAL_MINUTES=30

# ── Local model ──────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Let a reasoning-capable model think first. Slower; rarely helps extraction.
# Leave unset unless you know your model supports it.
# OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=120000

# ── Classification behaviour ─────────────────────────────────────────────────
# Applications below this confidence are ignored.
MIN_CONFIDENCE=0.6
# Days of silence before an open application is shown as ghosted.
GHOST_AFTER_DAYS=30
